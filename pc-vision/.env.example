# PC-Vision Configuration Example
# Copy this to .env and adjust values

# MQTT Broker
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_CLIENT_ID=gh-pc-vision

# ESP32-CAM URL
CAM_URL=http://192.168.4.1

# YOLO Configuration
# Use yolov8n.pt for pretrained, or path to custom trained model
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONF=0.25
YOLO_IOU=0.45

# Disease Detection Model (Hugging Face)
# Example: linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
DISEASE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
DISEASE_THRESHOLD=0.7

# Processing Interval (seconds)
INTERVAL_S=5.0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
